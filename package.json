{
  "name": "todz",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "@mintlify/cli>sharp": "0.35.5",
      "@mintlify/package-builder>js-yaml": "4.3.2"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "emails:generate": "pnpm --filter @todz/api emails:generate",
    "emails:check": "pnpm --filter @todz/api emails:check",
    "emails:preview": "pnpm --filter @todz/api emails:preview",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "test:unit": "pnpm -r test:unit && pnpm test:hooks && pnpm test:verify",
    "test:hooks": "bash .agents/hooks/hooks.test.sh",
    "test:verify": "bash scripts/verify.test.sh && bash scripts/pr-media.test.sh && bash scripts/todz-cloudflare.test.sh && bash scripts/deploy-worker.test.sh && bash scripts/release-mac.test.sh",
    "perf": "pnpm --filter @todz/perf perf",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "bash scripts/verify.sh",
    "release:mac": "bash scripts/release-mac.sh"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
