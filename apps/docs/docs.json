{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "todz",
  "favicon": "/favicon.svg",
  "logo": { "light": "/logo/light.svg", "dark": "/logo/dark.svg", "href": "/" },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This page does not exist.\n\n[Back to the Introduction](/)"
    }
  },
  "colors": {
    "primary": "#2F5BFF",
    "light": "#7C95FF",
    "dark": "#2F5BFF"
  },
  "background": { "color": { "light": "#F2F4FA", "dark": "#070812" } },
  "appearance": { "default": "system" },
  "navbar": { "links": [{ "label": "todz.app", "href": "https://todz.app" }] },
  "footer": {
    "links": [
      {
        "header": "todz is a product of",
        "items": [{ "label": "Logic Bit", "href": "https://logicbit.com.br" }]
      },
      {
        "header": "Open source",
        "items": [
          { "label": "Contributing", "href": "https://github.com/dhyegocalota/todz/blob/main/.github/CONTRIBUTING.md" },
          { "label": "Security", "href": "https://github.com/dhyegocalota/todz/blob/main/.github/SECURITY.md" },
          { "label": "License", "href": "https://github.com/dhyegocalota/todz/blob/main/LICENSE" }
        ]
      }
    ]
  },
  "navigation": {
    "groups": [
      { "group": "Get started", "pages": ["index", "quickstart", "install-on-mac", "connect-an-agent"] },
      {
        "group": "Guides",
        "pages": [
          "tour",
          "workspaces",
          "keyboard-shortcuts",
          "updates",
          "privacy",
          "troubleshooting",
          "uninstall",
          "use-these-docs-from-your-agent",
          "open-source"
        ]
      },
      { "group": "Reference", "pages": ["mcp-tools", "releases"] },
      { "group": "Self-host", "pages": ["self-host"] }
    ]
  }
}
