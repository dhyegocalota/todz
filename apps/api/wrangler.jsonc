{
  "name": "todz-api",
  "account_id": "e2035d8e0b7173d520ccf643f6f4661c",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "api.todz.app", "custom_domain": true },
    { "pattern": "todz.app", "custom_domain": true },
    { "pattern": "www.todz.app", "custom_domain": true },
  ],
  "triggers": { "crons": ["0 11 * * *", "*/15 * * * *"] },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    "SIGN_IN_PROVIDER": "email",
    "EMAIL_SENDER": "cloudflare",
    "PUBLIC_ORIGIN": "https://api.todz.app",
    "SITE_ORIGIN": "https://todz.app",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGSI2K7Qe9Vad2nL",
  },
  "d1_databases": [
    {
      "binding": "DIRECTORY",
      "database_name": "todz-directory",
      "database_id": "dc22b1c3-1869-44a0-b805-91bf92017f19",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_STORE", "class_name": "ProjectStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectStore"] }],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@todz.app"] }],
  "ratelimits": [
    { "name": "SIGN_IN_LIMITER", "namespace_id": "8601", "simple": { "limit": 10, "period": 60 } },
    { "name": "SIGN_IN_ADDRESS_LIMITER", "namespace_id": "8602", "simple": { "limit": 3, "period": 60 } },
    { "name": "SIGN_IN_GLOBAL_LIMITER", "namespace_id": "8603", "simple": { "limit": 100, "period": 60 } },
    { "name": "WAITLIST_LIMITER", "namespace_id": "8604", "simple": { "limit": 10, "period": 60 } },
    { "name": "WAITLIST_ADDRESS_LIMITER", "namespace_id": "8605", "simple": { "limit": 3, "period": 60 } },
    { "name": "WAITLIST_GLOBAL_LIMITER", "namespace_id": "8606", "simple": { "limit": 60, "period": 60 } },
    { "name": "ADMIN_LIMITER", "namespace_id": "8607", "simple": { "limit": 10, "period": 60 } },
    { "name": "ADMIN_ADDRESS_LIMITER", "namespace_id": "8608", "simple": { "limit": 3, "period": 60 } },
    { "name": "ADMIN_GLOBAL_LIMITER", "namespace_id": "8609", "simple": { "limit": 30, "period": 60 } },
  ],
  "assets": { "directory": "./public", "run_worker_first": ["/owner", "/owner/*", "/mcp", "/sign-in", "/sign-in/challenge", "/health"] },
}
