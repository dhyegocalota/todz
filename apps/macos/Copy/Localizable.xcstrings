    },
    "When an agent asks what's next, it hears what's due today in its project.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When an agent asks what's next, it hears what's due today in its project."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um agente pergunta o que vem a seguir, ele ouve o que vence hoje no projeto dele."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un agente pregunta qué sigue, oye lo que vence hoy en su proyecto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt ein Agent, was als Nächstes ansteht, hört er, was heute in seinem Projekt fällig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un agent demande ce qui vient ensuite, il entend ce qui est dû aujourd’hui dans son projet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが次にやることを尋ねると、そのプロジェクトで今日が期限のタスクを伝えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트가 다음에 할 일을 물으면 자기 프로젝트에서 오늘 마감인 작업을 함께 들어요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "智能体询问接下来做什么时，会听到它的项目中今天到期的任务。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يسأل وكيل عمّا هو تالٍ، يسمع ما يستحق اليوم في مشروعه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई एजेंट पूछता है कि आगे क्या है, तो उसे अपने प्रोजेक्ट में आज देय टास्क सुनाई देते हैं।"
          }
        }
      }
    },
