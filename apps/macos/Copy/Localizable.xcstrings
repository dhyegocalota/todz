    "Light, dark or the Mac's setting. Widgets follow the desktop.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light, dark or the Mac's setting. Widgets follow the desktop."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro, escuro ou o ajuste do Mac. Os widgets seguem a mesa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claro, oscuro o el ajuste del Mac. Los widgets siguen el escritorio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hell, dunkel oder die Einstellung des Macs. Widgets folgen dem Schreibtisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clair, sombre ou le réglage du Mac. Les widgets suivent le bureau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライト、ダーク、またはMacの設定に従います。ウィジェットはデスクトップに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이트, 다크 또는 Mac의 설정을 따라요. 위젯은 데스크탑을 따라요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "浅色、深色，或跟随 Mac 的设置。小组件跟随桌面。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فاتح أو داكن أو إعداد Mac. تتبع الويدجت سطح المكتب."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइट, डार्क या Mac की सेटिंग। विजेट डेस्कटॉप का पालन करते हैं।"
          }
        }
      }
    },
