    "At this time each day, todz mails Today to your sign-in address. Reply to add a task.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this time each day, todz mails Today to your sign-in address. Reply to add a task."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta hora, todos os dias, o todz envia Hoje por e-mail para o seu endereço de acesso. Responda para adicionar uma tarefa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A esta hora cada día, todz envía Hoy por correo a tu dirección de inicio de sesión. Responde para añadir una tarea."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu dieser Zeit jeden Tages sendet todz dir Heute per E-Mail an deine Anmeldeadresse. Antworte, um eine Aufgabe hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette heure chaque jour, todz envoie Aujourd’hui par e-mail à votre adresse de connexion. Répondez pour ajouter une tâche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日この時刻に、todzが今日のタスクをサインインに使ったアドレスにメールで送ります。返信すると、タスクを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 이 시각에 todz가 오늘 할 일을 로그인 주소로 메일로 보내요. 답장하면 작업이 추가돼요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每天这个时间，todz 会把今天的任务发到你的登录邮箱。回复邮件即可添加任务。"
          }
        }
      }
    },
    "At this time each day, todz opens on what's left of Today.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this time each day, todz opens on what's left of Today."
          }
        },
        "pt-BR": {
          "stringUnit": {
