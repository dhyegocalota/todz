    "A project groups tasks, and agents connect to it with their own keys.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A project groups tasks, and agents connect to it with their own keys."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um projeto reúne tarefas, e os agentes se conectam a ele com chaves próprias."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proyecto agrupa tareas, y los agentes se conectan a él con sus propias claves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Projekt bündelt Aufgaben, und Agenten verbinden sich mit ihren eigenen Schlüsseln damit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un projet regroupe des tâches, et les agents s’y connectent avec leurs propres clés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトはタスクをまとめるもので、エージェントはそれぞれ専用のキーで接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트는 작업을 묶어요. 에이전트는 각자의 키로 프로젝트에 연결해요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "项目用来归集任务，智能体用各自的密钥连接到它。"
          }
        }
      }
    },
    "A task needs a title.": {
      "extractionState": "manual",
