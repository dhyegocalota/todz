    "They haven't reached %@ yet. Switching erases them from this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They haven't reached %@ yet. Switching erases them from this Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Elas ainda não chegaram a %@. Trocar as apaga deste Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no han llegado a %@. Al cambiar, se borran de este Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben %@ noch nicht erreicht. Beim Wechsel werden sie von diesem Mac gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elles ne sont pas encore arrivées sur %@. Changer les efface de ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それらの変更は、まだ%@に届いていません。切り替えると、このMacから消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항이 아직 %@에 닿지 않았어요. 전환하면 이 Mac에서 지워져요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "它们还没有送达 %@。切换会把它们从这台 Mac 上抹掉。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تصل إلى %@ بعد. التبديل يمحوها من هذا الـ Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे अभी %@ तक नहीं पहुँचे हैं। बदलने पर वे इस Mac से मिट जाते हैं।"
          }
        }
      }
    },
    "They haven't reached %@ yet. Switching signs you out and erases them from this Mac.": {
