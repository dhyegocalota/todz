    "No open task in %@ matches “%@”.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No open task in %@ matches “%@”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma tarefa aberta em %@ corresponde a “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna tarea abierta en %@ coincide con «%@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine offene Aufgabe in %@ passt zu „%@“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune tâche ouverte dans %@ ne correspond à « %@ »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に、「%@」に一致する未完了のタスクはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에는 “%@”에 해당하는 열린 작업이 없어요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 中没有与“%2$@”匹配的未完成任务。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مهمة مفتوحة في %@ تطابق «%@»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ में कोई खुला टास्क “%2$@” से मेल नहीं खाता।"
          }
        }
      }
    },
