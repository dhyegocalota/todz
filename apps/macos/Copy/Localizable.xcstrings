    "Downloads new versions in the background and installs them when you quit or reopen todz.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads new versions in the background and installs them when you quit or reopen todz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa novas versões em segundo plano e as instala quando você fecha ou reabre o todz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga versiones nuevas en segundo plano y las instala cuando cierras o vuelves a abrir todz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt neue Versionen im Hintergrund herunter und installiert sie, wenn du todz beendest oder neu öffnest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge les nouvelles versions en arrière-plan et les installe quand vous quittez ou rouvrez todz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンをバックグラウンドでダウンロードし、todzを終了または再び開いたときにインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 버전을 백그라운드에서 내려받고, todz를 종료하거나 다시 열 때 설치해요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台下载新版本，并在你退出或重新打开 todz 时安装。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينزّل الإصدارات الجديدة في الخلفية ويثبّتها عندما تنهي todz أو تعيد فتحه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए संस्करण बैकग्राउंड में डाउनलोड करता है और todz छोड़ने या दोबारा खोलने पर इंस्टॉल करता है।"
          }
        }
      }
    },
