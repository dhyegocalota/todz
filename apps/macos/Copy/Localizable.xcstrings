    "Nothing moves unless you choose Move todz to Applications.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing moves unless you choose Move todz to Applications."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é movido a menos que você escolha Mover o todz para Aplicativos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se mueve nada a menos que elijas Mover todz a Aplicaciones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird verschoben, es sei denn, du wählst „todz in ‚Programme‘ verschieben“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne bouge tant que vous ne choisissez pas Déplacer todz dans Applications."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「todzをアプリケーションに移動」を選ばない限り、何も移動しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘todz를 응용 프로그램으로 이동’을 선택하지 않으면 아무것도 옮겨지지 않아요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你选择“把 todz 移到‘应用程序’”，否则不会移动任何东西。"
          }
        }
      }
    },
