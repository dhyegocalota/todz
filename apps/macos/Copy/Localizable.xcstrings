    "todz %@ is too old for this server. Update todz to keep syncing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "todz %@ is too old for this server. Update todz to keep syncing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O todz %@ é antigo demais para este servidor. Atualize o todz para continuar sincronizando."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "todz %@ es demasiado antiguo para este servidor. Actualiza todz para seguir sincronizando."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "todz %@ ist für diesen Server zu alt. Aktualisiere todz, um weiter zu synchronisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "todz %@ est trop ancien pour ce serveur. Mettez à jour todz pour continuer à synchroniser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "todz %@は、このサーバには古すぎます。同期を続けるには、todzをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "todz %@ 버전은 이 서버에 너무 오래됐어요. 동기화를 계속하려면 todz를 업데이트하세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "todz %@ 对这台服务器来说太旧了。请更新 todz 以继续同步。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "todz %@ أقدم من أن يعمل مع هذا الخادم. حدّث todz لمواصلة المزامنة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "todz %@ इस सर्वर के लिए बहुत पुराना है। सिंक जारी रखने के लिए todz अपडेट करें।"
          }
        }
      }
    },
