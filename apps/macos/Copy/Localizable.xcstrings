    "Turn on todz under Allow in the Menu Bar, in System Settings › Menu Bar, to see today's count and open the popover.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on todz under Allow in the Menu Bar, in System Settings › Menu Bar, to see today's count and open the popover."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o todz em Permitir na Barra de Menus, em Ajustes do Sistema › Barra de Menus, para ver a contagem de hoje e abrir o popover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa todz en Permitir en la barra de menús, en Ajustes del Sistema › Barra de menús, para ver el recuento de hoy y abrir el popover."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte todz unter „In Menüleiste erlauben“ in Systemeinstellungen › Menüleiste ein, um den Zähler für heute zu sehen und das Popover zu öffnen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez todz sous Autoriser dans la barre des menus, dans Réglages Système › Barre des menus, pour voir le compteur du jour et ouvrir le panneau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の件数を表示してポップオーバを開くには、システム設定 › メニューバーの「メニューバーに追加することを許可」でtodzをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 개수를 보고 팝오버를 열려면 시스템 설정 › 메뉴 막대의 ‘메뉴 막대에서 허용’ 아래에서 todz를 켜세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置 › 菜单栏的“允许在菜单栏显示”下开启 todz，以查看今天的计数并打开弹出窗口。"
          }
        }
      }
    },
