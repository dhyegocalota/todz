          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu dieser Zeit jeden Tages öffnet todz mit dem, was von Heute übrig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
