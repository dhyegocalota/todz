            "value": "Não foi possível entrar com esse link. Aguarde um minuto e abra-o de novo pelo e-mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión con ese enlace. Espera un minuto y vuelve a abrirlo desde el correo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung mit diesem Link nicht möglich. Warte eine Minute und öffne ihn dann erneut aus der E-Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vous connecter avec ce lien. Attendez une minute, puis rouvrez-le depuis l’e-mail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクではサインインできませんでした。1分待ってから、メールのリンクをもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크로는 로그인할 수 없어요. 잠시 기다린 뒤 이메일에서 다시 열어 주세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "无法用该链接登录。请等一分钟，然后再从邮件中打开一次。"
          }
        }
      }
    },
