    "Add todz to any MCP client with one command. The client opens your browser, where you sign in and pick a project.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add todz to any MCP client with one command. The client opens your browser, where you sign in and pick a project."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione o todz a qualquer cliente MCP com um único comando. O cliente abre o seu navegador, onde você entra e escolhe um projeto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade todz a cualquier cliente MCP con un solo comando. El cliente abre tu navegador, donde inicias sesión y eliges un proyecto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge todz mit einem Befehl jedem MCP-Client hinzu. Der Client öffnet deinen Browser, wo du dich anmeldest und ein Projekt wählst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez todz à n’importe quel client MCP avec une seule commande. Le client ouvre votre navigateur, où vous vous connectez et choisissez un projet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド1つで、todzをあらゆるMCPクライアントに追加できます。クライアントがブラウザを開くので、そこでサインインしてプロジェクトを選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 하나로 어떤 MCP 클라이언트에든 todz를 추가하세요. 클라이언트가 브라우저를 열면 로그인하고 프로젝트를 고르면 돼요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "用一条命令把 todz 添加到任何 MCP 客户端。客户端会打开你的浏览器，你在那里登录并选择一个项目。"
          }
        }
      }
    },
