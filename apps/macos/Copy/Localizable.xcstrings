    "History shows when todz is back online.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History shows when todz is back online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico aparece quando o todz voltar a ficar online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial aparece cuando todz vuelve a estar en línea."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf erscheint, sobald todz wieder online ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique s’affiche quand todz est de nouveau en ligne."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴は、todzがオンラインに戻ると表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "todz가 다시 온라인이 되면 기록이 나타나요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "待 todz 恢复在线后会显示历史记录。"
          }
        }
      }
    },
    "Hold two of ⌃, ⌥ or ⌘ with the key.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold two of ⌃, ⌥ or ⌘ with the key."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure duas entre ⌃, ⌥ ou ⌘ junto com a tecla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén dos de ⌃, ⌥ o ⌘ junto con la tecla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte zwei von ⌃, ⌥ oder ⌘ mit der Taste gedrückt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez deux touches parmi ⌃, ⌥ ou ⌘ avec la touche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーとあわせて、⌃、⌥、⌘のうち2つを押し続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키와 함께 ⌃, ⌥, ⌘ 중 두 개를 누르고 있어야 해요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "按键时需同时按住 ⌃、⌥ 或 ⌘ 中的两个。"
          }
        }
      }
    },
    "Hold what todz shows on this Mac in a Focus that has the todz filter.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold what todz shows on this Mac in a Focus that has the todz filter."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Retém o que o todz mostra neste Mac em um Foco que tem o filtro do todz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retén lo que todz muestra en este Mac durante un Foco que tenga el filtro de todz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält zurück, was todz auf diesem Mac anzeigt, in einem Fokus mit dem todz-Filter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retient ce que todz affiche sur ce Mac pendant un mode de concentration qui a le filtre todz."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "todzのフィルタを設定した集中モードの間は、このMacでのtodzの表示を控えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "todz 필터가 있는 집중 모드에서는 이 Mac에서 todz가 보여 주는 내용을 숨겨요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在设有 todz 过滤条件的专注模式下，暂缓 todz 在这台 Mac 上显示的内容。"
