    "You'll be signed out, and this Mac's copy of your tasks is erased. Your tasks stay on %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be signed out, and this Mac's copy of your tasks is erased. Your tasks stay on %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai sair, e a cópia das suas tarefas neste Mac será apagada. Suas tarefas continuam em %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará tu sesión y se borrará la copia de tus tareas en este Mac. Tus tareas siguen en %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst abgemeldet, und die Kopie deiner Aufgaben auf diesem Mac wird gelöscht. Deine Aufgaben bleiben auf %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez déconnecté, et la copie de vos tâches sur ce Mac sera effacée. Vos tâches restent sur %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトされ、このMacにあるタスクのコピーは消去されます。タスクは%@に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃되고 이 Mac에 있는 작업 사본이 지워져요. 작업은 %@에 그대로 남아요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你会退出登录，这台 Mac 上你的任务副本会被抹掉。你的任务仍保留在 %@。"
          }
        }
      }
    },
    "You're already signed in.": {
