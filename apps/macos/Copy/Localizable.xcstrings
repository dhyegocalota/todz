    },
    "A workspace holds one company's projects. It starts with an Inbox.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workspace holds one company's projects. It starts with an Inbox."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um workspace guarda os projetos de uma empresa. Ele começa com uma Caixa de entrada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espacio de trabajo contiene los proyectos de una empresa. Empieza con un Inbox."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Workspace enthält die Projekte eines Unternehmens. Er beginnt mit einer Inbox."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace de travail contient les projets d’une entreprise. Il commence avec une Boîte de réception."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースは、1社のプロジェクトをまとめたものです。最初はインボックスから始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스는 한 회사의 프로젝트를 담아요. Inbox와 함께 시작해요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "一个工作区容纳一家公司的各个项目。起初只有一个收件箱。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحوي مساحة العمل مشاريع شركة واحدة. وتبدأ بـ Inbox."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्कस्पेस एक कंपनी के प्रोजेक्ट रखता है। यह एक इनबॉक्स से शुरू होता है।"
          }
        }
      }
    },
    "A workspace keeps its own projects and tasks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A workspace keeps its own projects and tasks."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um workspace mantém os próprios projetos e tarefas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espacio de trabajo mantiene sus propios proyectos y tareas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Workspace hält seine eigenen Projekte und Aufgaben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace de travail garde ses propres projets et tâches."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースには、それぞれ専用のプロジェクトとタスクがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스는 자신의 프로젝트와 작업을 따로 보관해요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
