    "Also asks again when the Mac sleeps or the screen locks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also asks again when the Mac sleeps or the screen locks."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também pede de novo quando o Mac entra em repouso ou a tela bloqueia."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También vuelve a pedirlo cuando el Mac entra en reposo o la pantalla se bloquea."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt außerdem erneut, wenn der Mac in den Ruhezustand geht oder der Bildschirm gesperrt wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redemande aussi quand le Mac se met en veille ou que l’écran se verrouille."
          }
        },
        "ja": {
