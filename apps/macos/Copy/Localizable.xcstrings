    "This task changed before it could be deleted, so it was kept. Check it, then delete it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task changed before it could be deleted, so it was kept. Check it, then delete it again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa mudou antes de poder ser excluída, então foi mantida. Confira e exclua de novo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea cambió antes de poder eliminarse, así que se conservó. Revísala y vuelve a eliminarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe wurde geändert, bevor sie gelöscht werden konnte, deshalb wurde sie behalten. Prüfe sie und lösche sie dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche a changé avant de pouvoir être supprimée, elle a donc été conservée. Vérifiez-la, puis supprimez-la de nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクは削除される前に変更されたため、残されています。内容を確認してから、もう一度削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하기 전에 이 작업이 변경되어 그대로 남겨 두었어요. 내용을 확인한 뒤 다시 삭제하세요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "该任务在被删除之前发生了更改，所以已保留。请检查一下，然后再次删除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت هذه المهمة قبل أن تُحذف، فأُبقي عليها. تحقق منها، ثم احذفها مرة أخرى."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टास्क हटाए जाने से पहले बदल गया, इसलिए उसे रखा गया। उसे जाँचें, फिर दोबारा हटाएँ।"
          }
        }
      }
    },
