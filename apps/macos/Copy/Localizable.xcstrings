    "Development sign-in. Sign in with Apple comes later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development sign-in. Sign in with Apple comes later."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Login de desenvolvimento. Fazer login com a Apple vem depois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio de sesión de desarrollo. Iniciar sesión con Apple llegará más adelante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwicklungs-Anmeldung. „Mit Apple anmelden“ kommt später."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion de développement. La connexion avec Apple viendra plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発用のサインインです。Appleでサインインは、のちほど対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발용 로그인이에요. Apple로 로그인은 나중에 제공돼요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "开发用登录。使用 Apple 登录将在稍后推出。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل دخول للتطوير. تسجيل الدخول عبر Apple يأتي لاحقًا."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेवलपमेंट साइन-इन। Apple से साइन इन बाद में आएगा।"
          }
        }
      }
    },
    "Dims the menu bar count through the afternoon and tints overdue widget rows.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dims the menu bar count through the afternoon and tints overdue widget rows."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esmaece a contagem da barra de menus ao longo da tarde e dá um tom às linhas atrasadas dos widgets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenúa el recuento de la barra de menús a lo largo de la tarde y tiñe las filas vencidas de los widgets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimmt den Zähler der Menüleiste im Lauf des Nachmittags und färbt überfällige Widget-Zeilen ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atténue le compteur de la barre des menus au fil de l’après-midi et teinte les lignes en retard des widgets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "午後にかけてメニューバーの件数を暗くし、期限切れのウィジェットの行に色を付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오후 동안 메뉴 막대의 개수를 흐리게 하고, 기한이 지난 위젯 행에 색을 입혀요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "下午会逐渐调暗菜单栏的计数，并给小组件中逾期的行染色。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفّت عدّاد شريط القوائم على مدار فترة ما بعد الظهر ويصبغ صفوف الويدجت المتأخرة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोपहर भर मेन्यू बार की गिनती को धुँधला करता है और देर हो चुकी विजेट पंक्तियों को रंगत देता है।"
          }
        }
      }
    },
