    "Now and then, shows what's next beside the menu bar icon for a few seconds.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now and then, shows what's next beside the menu bar icon for a few seconds."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De vez em quando, mostra o que vem a seguir ao lado do ícone da barra de menus por alguns segundos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De vez en cuando, muestra lo que sigue junto al icono de la barra de menús durante unos segundos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt ab und zu für ein paar Sekunden neben dem Symbol der Menüleiste, was als Nächstes ansteht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De temps en temps, affiche ce qui vient ensuite à côté de l’icône de la barre des menus pendant quelques secondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ときどき、次にやることをメニューバーのアイコンの横に数秒間表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가끔 몇 초 동안 메뉴 막대 아이콘 옆에 다음 할 일을 보여 줘요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "不时在菜单栏图标旁显示接下来要做的事，持续几秒钟。"
          }
        }
      }
    },
