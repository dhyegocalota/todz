    "todz could not be moved to Applications and could not remove its temporary copy there. Nothing else was changed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "todz could not be moved to Applications and could not remove its temporary copy there. Nothing else was changed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mover o todz para Aplicativos nem remover a cópia temporária dele lá. Nada mais foi alterado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo mover todz a Aplicaciones ni eliminar su copia temporal allí. No se cambió nada más."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "todz konnte nicht in „Programme“ verschoben werden und konnte seine temporäre Kopie dort nicht entfernen. Sonst wurde nichts geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "todz n’a pas pu être déplacé dans Applications et n’a pas pu y supprimer sa copie temporaire. Rien d’autre n’a été modifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "todzをアプリケーションに移動できず、そこにある一時的なコピーも削除できませんでした。ほかには何も変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "todz를 응용 프로그램 폴더로 옮기지 못했고, 거기 있던 임시 사본도 지우지 못했어요. 그 밖에는 바뀐 것이 없어요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "todz 无法移到“应用程序”，也无法删除它在那里的临时副本。其他内容均未更改。"
          }
        }
      }
    },
    "todz could not be moved to Applications. Nothing was changed, and it keeps running from here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "todz could not be moved to Applications. Nothing was changed, and it keeps running from here."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível mover o todz para Aplicativos. Nada foi alterado, e ele continua rodando daqui."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo mover todz a Aplicaciones. No se cambió nada, y sigue ejecutándose desde aquí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "todz konnte nicht in „Programme“ verschoben werden. Nichts wurde geändert, und es läuft von hier weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "todz n’a pas pu être déplacé dans Applications. Rien n’a été modifié, et il continue de s’exécuter d’ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "todzをアプリケーションに移動できませんでした。何も変更されておらず、このまま現在の場所で動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "todz를 응용 프로그램 폴더로 옮기지 못했어요. 아무것도 바뀌지 않았고 여기서 계속 실행돼요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "todz 无法移到“应用程序”。没有任何更改，它会继续从这里运行。"
