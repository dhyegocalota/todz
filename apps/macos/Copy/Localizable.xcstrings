          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتفظ مساحة العمل بمشاريعها ومهامها الخاصة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
