    "Ask for Touch ID or your Mac password before switching workspaces.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask for Touch ID or your Mac password before switching workspaces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça o Touch ID ou a senha do Mac antes de trocar de workspace."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide Touch ID o la contraseña de tu Mac antes de cambiar de espacio de trabajo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Wechsel des Workspace nach Touch ID oder deinem Mac-Passwort fragen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande Touch ID ou le mot de passe de votre Mac avant de changer d’espace de travail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースを切り替える前に、Touch IDまたはMacのパスワードを求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스를 전환하기 전에 Touch ID나 Mac 암호를 요청해요."
          }
        },
        "zh": {
          "stringUnit": {
