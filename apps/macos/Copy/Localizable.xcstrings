    "You're signed in, but todz couldn't save your session for next time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're signed in, but todz couldn't save your session for next time."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está conectado, mas o todz não conseguiu salvar a sua sessão para a próxima vez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has iniciado sesión, pero todz no pudo guardar tu sesión para la próxima vez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist angemeldet, aber todz konnte deine Sitzung nicht für das nächste Mal sichern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes connecté, mais todz n’a pas pu enregistrer votre session pour la prochaine fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインしていますが、todzは次回に備えたセッションを保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인은 됐지만 다음에 쓸 세션을 todz가 저장하지 못했어요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你已登录，但 todz 无法保存你的会话供下次使用。"
          }
        }
      }
    },
