    "At this time each day, todz mails Today to your sign-in address. Reply to add a task.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this time each day, todz mails Today to your sign-in address. Reply to add a task."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta hora, todos os dias, o todz envia Hoje por e-mail para o seu endereço de acesso. Responda para adicionar uma tarefa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A esta hora cada día, todz envía Hoy por correo a tu dirección de inicio de sesión. Responde para añadir una tarea."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu dieser Zeit jeden Tages sendet todz dir Heute per E-Mail an deine Anmeldeadresse. Antworte, um eine Aufgabe hinzuzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette heure chaque jour, todz envoie Aujourd’hui par e-mail à votre adresse de connexion. Répondez pour ajouter une tâche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日この時刻に、todzが今日のタスクをサインインに使ったアドレスにメールで送ります。返信すると、タスクを追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 이 시각에 todz가 오늘 할 일을 로그인 주소로 메일로 보내요. 답장하면 작업이 추가돼요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每天这个时间，todz 会把今天的任务发到你的登录邮箱。回复邮件即可添加任务。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في هذا الوقت كل يوم، يرسل todz اليوم إلى عنوان تسجيل دخولك بالبريد. ردّ لإضافة مهمة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन इस समय todz आपके साइन-इन पते पर आज की सूची मेल करता है। टास्क जोड़ने के लिए जवाब दें।"
          }
        }
      }
    },
    "At this time each day, todz opens on what's left of Today.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this time each day, todz opens on what's left of Today."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta hora, todos os dias, o todz abre no que resta de Hoje."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A esta hora cada día, todz se abre en lo que queda de Hoy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu dieser Zeit jeden Tages öffnet todz mit dem, was von Heute übrig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette heure chaque jour, todz s’ouvre sur ce qui reste d’Aujourd’hui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日この時刻に、todzが今日の残りのタスクを表示して開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일 이 시각에 todz가 오늘 남은 할 일로 열려요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "每天这个时间，todz 会打开并显示今天还剩下的任务。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في هذا الوقت كل يوم، يفتح todz على ما تبقى من اليوم."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन इस समय todz आज की बची हुई सूची पर खुलता है।"
          }
        }
      }
    },
