        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 잠자기에 들어가거나 화면이 잠길 때도 다시 물어요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 进入睡眠或屏幕锁定时也会再次询问。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ويسأل مجددًا أيضًا عندما ينام Mac أو تُقفل الشاشة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब Mac सो जाए या स्क्रीन लॉक हो, तब भी दोबारा पूछता है।"
          }
        }
      }
    },
    "Another workspace shortcut already uses those keys.": {
