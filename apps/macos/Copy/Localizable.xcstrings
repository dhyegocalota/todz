          }
        }
      }
    },
    "Your changes wait here and are sent when the limit lifts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes wait here and are sent when the limit lifts."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas alterações esperam aqui e são enviadas quando o limite for liberado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cambios esperan aquí y se envían cuando se levante el límite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen warten hier und werden gesendet, sobald das Limit aufgehoben ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications attendent ici et sont envoyées quand la limite est levée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はここで待機し、上限が解除されたら送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 여기서 대기했다가 한도가 풀리면 전송돼요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的更改会留在这里，待限制解除后发送。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتظر تغييراتك هنا وتُرسل عند رفع الحد."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बदलाव यहीं प्रतीक्षा करते हैं और सीमा हटते ही भेज दिए जाते हैं।"
          }
        }
      }
    },
    "Your changes wait here until then.": {
      "extractionState": "manual",
      "localizations": {
