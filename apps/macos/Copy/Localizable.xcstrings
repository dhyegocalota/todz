    "“%@” and its history are deleted permanently. It cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” and its history are deleted permanently. It cannot be undone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” e o histórico dela são excluídos em definitivo. Não dá para desfazer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» y su historial se eliminan para siempre. No se puede deshacer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ und ihr Verlauf werden endgültig gelöscht. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » et son historique sont supprimés définitivement. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」とその履歴は完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 작업과 그 기록이 영구적으로 삭제돼요. 되돌릴 수 없어요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”及其历史记录会被永久删除。此操作无法撤销。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» وسجلها تُحذف نهائيًا. ولا يمكن التراجع عن ذلك."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” और उसका इतिहास हमेशा के लिए हटा दिया जाता है। इसे पूर्ववत नहीं किया जा सकता।"
          }
        }
      }
    },
    "“%@” is already done.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is already done."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” já está concluída."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» ya está hecha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist bereits erledigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est déjà terminée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はすでに完了しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” 작업은 이미 완료됐어요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已经完成了。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» منجزة بالفعل."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” पहले से पूरा है।"
          }
        }
      }
    },
    "⌃1–⌃9 can clash with Mission Control's Switch to Desktop keys. If both are on, the system wins.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃1–⌃9 can clash with Mission Control's Switch to Desktop keys. If both are on, the system wins."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As teclas ⌃1–⌃9 podem conflitar com as teclas de Mudar para a Mesa do Mission Control. Se as duas estiverem ativas, o sistema vence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃1–⌃9 puede chocar con las teclas Cambiar al escritorio de Mission Control. Si ambas están activadas, gana el sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃1–⌃9 können mit den Tasten „Zu Schreibtisch wechseln“ von Mission Control kollidieren. Sind beide an, gewinnt das System."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃1–⌃9 peut entrer en conflit avec les touches Passer au bureau de Mission Control. Si les deux sont activées, le système l’emporte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃1〜⌃9は、Mission Controlの「デスクトップへ切り替える」キーと衝突することがあります。両方がオンの場合は、システムが優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃1–⌃9는 Mission Control의 데스크탑으로 전환 키와 겹칠 수 있어요. 둘 다 켜져 있으면 시스템이 우선해요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃1–⌃9 可能与调度中心的“切换到桌面”按键冲突。如果两者都开启，以系统为准。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تتعارض ⌃1–⌃9 مع مفاتيح «التبديل إلى سطح المكتب» في Mission Control. إذا كان الاثنان مفعّلين، فالنظام هو الذي يفوز."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⌃1–⌃9 Mission Control की डेस्कटॉप पर स्विच करें कुंजियों से टकरा सकते हैं। अगर दोनों चालू हैं, तो सिस्टम जीतता है।"
          }
        }
      }
    }
  },
  "version": "1.0"
}
