    "This server is older than this app expects. Whoever runs it can update it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server is older than this app expects. Whoever runs it can update it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor é mais antigo do que este app espera. Quem o administra pode atualizá-lo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor es más antiguo de lo que la app espera. Quien lo administra puede actualizarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server ist älter, als diese App erwartet. Wer ihn betreibt, kann ihn aktualisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur est plus ancien que ce que cette app attend. Celui ou celle qui l’exploite peut le mettre à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバは、アプリが想定しているより古いバージョンです。運用している人がアップデートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버가 앱이 기대하는 버전보다 오래됐어요. 서버를 운영하는 사람이 업데이트할 수 있어요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器比这个 App 期望的版本旧。运行它的人可以更新它。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الخادم أقدم مما يتوقعه هذا التطبيق. يمكن لمن يديره تحديثه."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सर्वर उस संस्करण से पुराना है जिसकी यह ऐप उम्मीद करता है। इसे चलाने वाला इसे अपडेट कर सकता है।"
          }
        }
      }
    },
