          "stringUnit": {
            "state": "translated",
            "value": "You reopened it"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você a reabriu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reabriste tú"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast sie wieder geöffnet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous l’avez rouverte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが再オープンしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 다시 열음"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你重新打开了它"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعدت فتحها"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने इसे दोबारा खोला"
          }
        }
      }
    },
    "You'll be signed out, and this Mac's copy of your tasks is erased. Your tasks stay on %@.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be signed out, and this Mac's copy of your tasks is erased. Your tasks stay on %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você vai sair, e a cópia das suas tarefas neste Mac será apagada. Suas tarefas continuam em %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará tu sesión y se borrará la copia de tus tareas en este Mac. Tus tareas siguen en %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst abgemeldet, und die Kopie deiner Aufgaben auf diesem Mac wird gelöscht. Deine Aufgaben bleiben auf %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous serez déconnecté, et la copie de vos tâches sur ce Mac sera effacée. Vos tâches restent sur %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトされ、このMacにあるタスクのコピーは消去されます。タスクは%@に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃되고 이 Mac에 있는 작업 사본이 지워져요. 작업은 %@에 그대로 남아요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你会退出登录，这台 Mac 上你的任务副本会被抹掉。你的任务仍保留在 %@。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُسجَّل خروجك، وتُمحى نسخة مهامك على هذا الـ Mac. تبقى مهامك على %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप साइन आउट हो जाएँगे, और आपके टास्क की इस Mac की कॉपी मिट जाएगी। आपके टास्क %@ पर बने रहते हैं।"
          }
        }
      }
    },
    "You're already signed in.": {
      "extractionState": "manual",
      "localizations": {
