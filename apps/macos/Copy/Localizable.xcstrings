    "Where your tasks are kept. Switching signs you out and erases this Mac's copy.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where your tasks are kept. Switching signs you out and erases this Mac's copy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde as suas tarefas ficam guardadas. Trocar faz você sair e apaga a cópia deste Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde se guardan tus tareas. Al cambiar, se cierra tu sesión y se borra la copia de este Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo deine Aufgaben gespeichert sind. Beim Wechsel wirst du abgemeldet und die Kopie dieses Macs wird gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où vos tâches sont conservées. Changer vous déconnecte et efface la copie de ce Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクが保管されている場所です。切り替えると、サインアウトされ、このMacのコピーが消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 보관되는 곳이에요. 전환하면 로그아웃되고 이 Mac의 사본이 지워져요."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你的任务保存在哪里。切换会让你退出登录，并抹掉这台 Mac 上的副本。"
          }
        }
      }
    },
